# Copy to .env and fill in. Database is SQLite (see settings.py).
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

RETENTION_DAYS=60
LOG_RETENTION_DAYS=90

# Optional: AI answers on semantic search. Without a key, search still works,
# you just don't get the generated answer. Model id from openrouter.ai/models.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_LLM_MODEL=

# Optional: leave QDRANT_URL empty to use embedded Qdrant stored in ./qdrant_data.
# Set it (e.g. http://localhost:6333 or a Qdrant Cloud URL) to use a server.
QDRANT_URL=
QDRANT_API_KEY=
